# Python bytecode / caches / venvs
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
# Local config holding real account credentials (created by `openwrite.py setup`)
openwrite.yaml
# Atomic-write temp files created next to openwrite.yaml by preferences.set_account_author().
# They contain the full config including AppSecret, so they must never be tracked
# even if a crash leaves one behind.
openwrite-config-*
# Legacy flat config from before the YAML migration; never track real secrets.
.env
.env.*
!.env.example
.env-*

# Internal atomic-write / staging temp artifacts (normally inside articles/,
# which is ignored below; listed here so they can never be committed anywhere).
.workflow-*
.images-*

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local generation artifacts (do NOT commit test images / scratch covers)
test_generated_image.*
preview-output/
output/
*.tmp
*.log

# Test / coverage caches
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Defensive: the publisher no longer reads this path, but a legacy file here
# would contain AppID/AppSecret. Real credentials belong in openwrite.yaml.
skills/wechat-draft-publisher/config.json

# Note:
# - cover.png is NOT globally ignored anymore; individual skills can choose to
#   commit a real cover image. Skill scratch covers at the skill root were a
#   historical mistake and have been cleaned up.
# - skills/openwrite-images/config.json holds ComfyUI paths and IS tracked
#   so you have a working default; override per-machine via env vars
#   (COMFYUI_URL / COMFYUI_OUTPUT_DIR) instead of editing the file.
#
# Account credentials (app_id / app_secret / author / cookie) live in the local
# openwrite.yaml created by `.venv/bin/python openwrite.py setup`. It is ignored
# above; openwrite.example.yaml stays tracked as a placeholder template and must
# never hold real secrets.

# Local article workspaces (keep only the empty directory marker)
/articles/*
!/articles/.gitkeep
