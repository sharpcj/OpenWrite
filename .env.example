# OpenWrite 配置模板（平台、写作视角、微信公众号凭证）
# 本文件只是打样模板，会被 Git 跟踪，不参与任何运行时解析。
# 运行 python3 openwrite.py setup 复制为 .env 后填写；运行时只读取 .env。
# .env 已被 Git 忽略，只按 KEY=value 解析，不执行命令，也不做环境变量展开。
# 平台：本次提示词明确指定 > 配置中唯一的 true > 询问用户确认。
# 平台全部为 false 或同时多个为 true 且提示词未指定时，必须确认，不自行猜测。
# 视角：本次提示词明确指定 > WriterRole > 默认 SelfMediaBlogger。
# 本次提示词的选择只作用于当前任务，不回写长期配置。
# 已确定的平台和视角应保存在任务中，继续同一任务时沿用。

# 发布平台（微信与小红书均已完整接入；小红书发布默认仅自己可见）
WeChat=true
Rednote=false

# 写作视角（单选：SelfMediaBlogger / TechWriter / ProductManager）
# 缺省或留空时默认 SelfMediaBlogger（自媒体博主）；旧版三个布尔开关已废弃。
WriterRole=SelfMediaBlogger

# 微信封面图样式：三个维度独立配置，可使用中文或自定义描述。
# 本次提示词明确指定 > 本地 .env 配置；创建任务时保存，之后改配置不影响已有任务。
# 留空的维度由当次封面设计明确，Agent 应在不确定时请用户选择。
# 版式示例：左文右图 / 居中标题 / 上文下图 / 自定义构图描述。
# 左文右图：整张统一背景，主体靠右，左侧留白叠加标题与关键词句，不与主体重叠。
WeChatCoverLayout="左文右图"
# 视觉风格示例：温暖插画 / 科技线稿 / 写实摄影 / 极简抽象。
WeChatCoverVisualStyle="温暖插画"
# 色调示例：暖黄奶油色 / 青绿渐变 / 蓝紫渐变 / 自定义品牌色及色值。
WeChatCoverColorTone="暖黄奶油色"

# 写作流程检查点
# OutlineApproval=true：分析完成后、写正文前，必须给出三个备选标题
#（至少一个激进悬念、一个客观中性，第三个默认利益实用）与大纲，
# 由用户选定标题并确认大纲后才生成全文；可反复讨论修改。
# 设为 false 表示用户授权跳过该检查点，AI 直接写正文。
# 该选择在 new / workflow init 时写入任务状态，之后改配置不影响已有任务。
OutlineApproval=true

# --- 配图来源（openwrite-images） ---
# 服务地址与密钥统一配置在本文件（setup 复制为 .env 后填写）；
# 模型档案、来源优先级与叠字字体等底层默认参数在 skills/openwrite-images/config.json。
# ComfyUI 服务地址（含端口），本地或远程均可；多个地址用逗号分隔，本地优先。
# 缺省默认 http://localhost:8188。
COMFYUI_SERVER_URL=

# 在线 AI 生图：fal.ai（FLUX / Recraft 等）
# 获取：https://fal.ai/dashboard/keys ；两个键任填其一即可（别名关系）。
FAL_KEY=
FAL_AI_API_KEY=

# 在线 AI 生图：腾讯混元 TokenHub（Bearer token，Hy-Image 系列）
# 获取：https://console.cloud.tencent.com/tokenhub
TENCENT_TOKENHUB_API_KEY=

# 免费图片资源站点（搜索并下载正版免费图片）
# Pexels: https://www.pexels.com/api/  Pixabay: https://pixabay.com/api/docs/
# Unsplash: https://unsplash.com/developers
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# 微信公众号凭证（上传草稿时使用）
# 本文件只是占位模板且会被 Git 跟踪；真实密钥请写入 .env。
# 首次使用运行：python3 openwrite.py setup  （复制本文件为 .env，不覆盖已有文件）
# 然后编辑 .env 填写下面三项；.env 已被 .gitignore 忽略，文件权限为 600。
# 获取方式：https://mp.weixin.qq.com → 设置与开发 → 基本配置
# 值含空格时用双引号包裹，例如 WeChatAuthor="我的 公众号"
WeChatAppID=
WeChatAppSecret=
WeChatAuthor=

# 小红书创作服务平台 Cookie（发布笔记时使用）
# 浏览器登录 https://creator.xiaohongshu.com 后，开发者工具 → 网络，
# 复制任一创作平台请求的完整 Cookie（需含 a1 与 web_session 等登录凭证）。
# 发布默认「仅自己可见」；公开需显式 --public 授权。Cookie 会过期，失效时重新复制。
# 真实 Cookie 只写在 .env，不要写入本模板或提交到仓库。
XhsCreatorCookie=
